{
  "manifest_version": 3,
  "name": "Beginning Stack",
  "version": "1.0",
  "description": "Chrome extension that give proper analysis on you coding problem solution.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["data.js","content.js"]
    }
  ]
}
